; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chadot Porsche ReLight Showcase"
config/description="This scene demonstrates the use of Chadot's ReLight Lightmapper and Custom Reflection Probes.
License : Creative Commons (CC) BY 4.0"
config/tags=PackedStringArray("lab")
run/main_scene="uid://bguy24akf4kk0"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://Resources/icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Materials/": "orange",
"res://Resources/": "green"
}

[gui]

common/auto_focus_strategy=1

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/streaming/enabled=true
textures/streaming/memory_budget_enabled=true
rendering_device/driver.windows="d3d12"
lights_and_shadows/multi_bounce_occlusion/enabled=true
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=3
anti_aliasing/quality/msaa_3d=1
anti_aliasing/screen_space_roughness_limiter/limit=0.11
scaling_3d/mode=2
environment/screen_space_reflection/half_size=false
lightmapping/atlas/per_object_slices=true
anti_aliasing/quality/screen_space_aa=2
